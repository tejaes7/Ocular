{
  "manifest_version": 3,
  "name": "Ocular",
  "version": "0.2.0",
  "description": "Watch prices on the products you care about. Local-first, free, no account.",
  "minimum_chrome_version": "116",

  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "offscreen",
    "scripting",
    "tabs",
    "downloads",
    "activeTab",
    "idle"
  ],

  "host_permissions": [
    "https://www.amazon.in/*",
    "https://www.amazon.com/*",
    "https://www.flipkart.com/*",
    "https://www.myntra.com/*",
    "https://www.ajio.com/*",
    "https://www.croma.com/*",
    "https://www.reliancedigital.in/*",
    "https://www.nykaa.com/*",
    "https://www.tatacliq.com/*",
    "https://www.meesho.com/*"
  ],

  "optional_host_permissions": ["*://*/*"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Ocular",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_page": "options.html",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.in/*",
        "https://www.amazon.com/*",
        "https://www.flipkart.com/*",
        "https://www.myntra.com/*",
        "https://www.ajio.com/*",
        "https://www.croma.com/*",
        "https://www.reliancedigital.in/*",
        "https://www.nykaa.com/*",
        "https://www.tatacliq.com/*",
        "https://www.meesho.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
