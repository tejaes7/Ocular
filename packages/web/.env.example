# Copy to .env.local and fill in. .env.local is gitignored.
#
# Vite only exposes variables prefixed VITE_ to the browser, and every value here
# ends up readable in the shipped bundle. Nothing secret goes in this file.
#
# There is no Firebase config here either: a Firebase web apiKey is a public
# client identifier rather than a secret, so it lives in src/firebase.js.

# Base URL of the @ocular/backend Cloudflare Worker.
#
# Required. There is deliberately no default — this used to fall back to a
# specific deployment, which meant a misconfigured build looked healthy while
# calling a backend nobody intended. Unset, the site loads and any call that
# needs the backend fails with a message naming this variable.
#
#   local development :  http://127.0.0.1:8787
#                        (start it with `npm run dev` in packages/backend)
#
#   deployed          :  https://ocular.<your-subdomain>.workers.dev
#                        Set this in the Vercel project settings, not in a file.
VITE_API_BASE=http://127.0.0.1:8787
